{
  "name": "tayyor-sweet-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Tayyor & Sweet — Telegram bot va API (Express + Telegraf + PostgreSQL)",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "telegraf": "^4.16.3"
  }
}
