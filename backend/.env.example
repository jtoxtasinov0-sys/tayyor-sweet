# --- Telegram ---
BOT_TOKEN=123456:ABC...            # @BotFather bergan token
BOT_USERNAME=                      # bo'sh qolsa avtomatik aniqlanadi
ADMIN_IDS=                         # admin Telegram ID lari, vergul bilan (masalan 12345,67890)
ADMIN_PASSWORD=                    # admin panel va "/admin parol" uchun
ADMIN_SECRET=                      # uzun tasodifiy satr (token imzosi)
OWNER_LINK=https://t.me/username   # "Egasiga yozish" tugmasi

# --- Baza (Neon) ---
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# --- Manzillar ---
MINIAPP_URL=https://tayyor-sweet.vercel.app   # Vercel'dagi mini ilova (https bo'lishi shart)
PUBLIC_URL=                        # backend manzili (Render'da avtomatik). Bo'sh bo'lsa — polling
CORS_ORIGINS=                      # bo'sh = hammaga ruxsat
WEBHOOK_SECRET=                    # tasodifiy satr

# --- Nomlar ---
SHOP_NAME=Tayyor & Sweet
SHOP_SHORT_NAME=TS
ORDER_PREFIX=TS

# --- Mahalliy sinov ---
PORT=4000
ALLOW_DEV_AUTH=1                   # brauzerda Telegramsiz ochish uchun (productionda ishlamaydi)

# --- Saytdan buyurtma ---
ALLOW_GUEST_ORDERS=                # bo'sh = yoqilgan (saytdan Telegramsiz buyurtma). 0 = faqat Telegram orqali
